# Maintainer: NeoMixer contributors
pkgname=neomixer
pkgver=@VERSION@
pkgrel=1
pkgdesc='Virtual audio mixer for PipeWire, with an EQ on every channel and remembered program routing'
arch=('any')
license=('MIT')
depends=(
  'gtk4'
  'libpulse'
  'pipewire'
  'pipewire-audio'
  'pipewire-pulse'
  'python'
  'python-cairo'
  'python-gobject'
  'python-pydantic'
  'wireplumber'
)
makedepends=('python-babel')
# Arch has no package of pulsectl and pulsectl-asyncio, so they come along
source=("$pkgname-$pkgver.tar.gz"
        'pulsectl-24.12.0-py2.py3-none-any.whl'
        'pulsectl_asyncio-1.3.2-py3-none-any.whl')
noextract=('pulsectl-24.12.0-py2.py3-none-any.whl'
           'pulsectl_asyncio-1.3.2-py3-none-any.whl')
sha256sums=('SKIP'
            '13a60be940594f03ead3245b3dfe3aff4a3f9a792af347674bde5e716d4f76d2'
            'aa3adf89fe91a80ec1a5c92de3dcfd17a8f171006a07a2ec59a4a13d031fc70d')

package() {
  cd "$pkgname-$pkgver"
  install -d "$pkgdir/usr/lib/neomixer"
  for wheel in "$srcdir"/*.whl; do
    python -m zipfile -e "$wheel" "$pkgdir/usr/lib/neomixer"
  done
  rm -r "$pkgdir/usr/lib/neomixer/pulsectl/tests"
  packaging/install-tree.sh "$pkgdir"
}
