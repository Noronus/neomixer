Depends: gir1.2-gtk-4.0, libpulse0, libspa-0.2-modules, pipewire, pipewire-bin, pipewire-pulse, python3, python3-cairo, python3-gi, python3-gi-cairo, python3-pulsectl (>= 23.5.0), python3-pydantic, wireplumber
Section: sound
